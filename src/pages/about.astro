---
import Layout from '../layouts/BlogPost.astro';
---

<Layout
	title="关于我"
	description=""
    pubDate={new Date()}
>
    <div class="about-container">
        <h1>关于我</h1>
        <p>一个热爱写作和分享的程序员，正在进行100天日更挑战 ✍️</p>
        <div class="social-links">
            <a href="#">GitHub</a>
            <a href="#">微博</a>
            <a href="#">邮箱</a>
        </div>
    </div>
</Layout>

<style>
    .about-container {
        padding: 2rem;
        text-align: center;
    }
    h1 {
        font-size: 2rem;
        margin-bottom: 0.5rem;
        color: #2563eb;
    }
    p {
        color: #666;
        margin-bottom: 1rem;
    }
    .social-links {
        display: flex;
        gap: 1rem;
        justify-content: center;
    }
    .social-links a {
        padding: 0.5rem 1rem;
        background: #f1f5f9;
        border-radius: 8px;
        text-decoration: none;
        color: #666;
        font-size: 0.9rem;
        transition: all 0.3s;
    }
    .social-links a:hover {
        background: #2563eb;
        color: white;
    }
</style>