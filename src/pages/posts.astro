---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';

// 获取所有博客文章和日更文章
const blogPosts = await getCollection('blog');
const dailyPosts = await getCollection('daily');

// 合并所有文章并按日期排序
const allPosts = [...blogPosts, ...dailyPosts];
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="所有文章 - 退场修行" description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.page-header {
				text-align: center;
				margin-bottom: 2rem;
			}
			.page-header h1 {
				font-size: 2.5rem;
				color: rgb(var(--accent));
				margin-bottom: 0.5rem;
			}
			.page-header p {
				color: rgb(var(--gray));
				font-size: 1.1rem;
			}
			.stats {
				text-align: center;
				margin-bottom: 2rem;
				padding: 1rem;
				background: rgb(var(--gray-light));
				border-radius: 8px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
				padding: 1rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				position: relative;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			.post-meta {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.5rem;
			}
			.post-type {
				font-size: 0.8rem;
				padding: 0.2rem 0.5rem;
				border-radius: 4px;
				font-weight: 500;
			}
			.post-type.blog {
				background: #dbeafe;
				color: #1e40af;
			}
			.post-type.daily {
				background: #dcfce7;
				color: #166534;
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			ul a:hover {
				border-color: rgb(var(--accent));
				box-shadow: var(--box-shadow);
			}
			.empty-state {
				text-align: center;
				padding: 3rem;
				color: rgb(var(--gray));
			}
			.empty-state h3 {
				margin-bottom: 1rem;
				color: rgb(var(--black));
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>📚 所有文章</h1>
				<p>探索博客和日更的全部内容</p>
			</div>
			
			<div class="stats">
				<strong>共 {sortedPosts.length} 篇文章</strong> 
				（博客 {blogPosts.length} 篇，日更 {dailyPosts.length} 篇）
			</div>
			
			<section>
				{sortedPosts.length > 0 ? (
					<ul>
						{
							sortedPosts.map((post) => {
								// 检查文章来自哪个集合
								const isDaily = dailyPosts.some(daily => daily.id === post.id);
								const postUrl = isDaily ? `/daily/${post.id}/` : `/blog/${post.id}/`;
								const postType = isDaily ? 'daily' : 'blog';
								const postTypeLabel = isDaily ? '日更' : '博客';
								
								return (
									<li>
										<a href={postUrl}>
											{post.data.heroImage && (
												<Image width={720} height={360} src={post.data.heroImage} alt="" />
											)}
											<div class="post-meta">
												<span class="date">
													<FormattedDate date={post.data.pubDate} />
												</span>
												<span class={`post-type ${postType}`}>{postTypeLabel}</span>
											</div>
											<h4 class="title">{post.data.title}</h4>
											<p style="color: rgb(var(--gray)); margin-top: 0.5rem;">
												{post.data.description}
											</p>
										</a>
									</li>
								);
							})
						}
					</ul>
				) : (
					<div class="empty-state">
						<h3>📝 暂无文章</h3>
						<p>内容正在筹备中...</p>
					</div>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
