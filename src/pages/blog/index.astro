---
// Blog Index Page
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import BlogCard from '../../components/BlogCard.astro';
import Search from '../../components/Search.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// Get all blog posts (excluding drafts)
const allPosts = await getCollection('blog', ({ data }) => {
  return !data.draft;
});

// Sort posts by publication date (newest first)
const posts = allPosts.sort((a, b) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Prepare search data
const searchData = posts.map(post => ({
  slug: post.slug,
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags || [],
  pubDate: post.data.pubDate.toISOString(),
  content: post.body || '',
}));

// Get all unique tags
const allTags = [...new Set(posts.flatMap(post => post.data.tags || []))].sort();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Blog | ${SITE_TITLE}`}
			description={`Read ${posts.length} articles about technology, development, and more. ${SITE_DESCRIPTION}`}
		/>

		<!-- Search data for client-side search -->
		<script define:vars={{ searchData }}>
			window.searchIndex = searchData;
		</script>
	</head>

	<body>
		<Header />

		<!-- Page Header -->
		<section class="page-header">
			<div class="container">
				<div class="page-header-content">
					<h1 class="page-title">Blog</h1>
					<p class="page-description">
						{posts.length} articles about technology, development, and life.
					</p>

					<!-- Search -->
					<div class="search-wrapper">
						<Search />
					</div>

					<!-- Tag Filter -->
					{allTags.length > 0 && (
						<div class="tag-filter">
							<span class="filter-label">Filter by tag:</span>
							<div class="tag-buttons">
								<button
									class="tag-button active"
									data-tag="all"
									aria-label="Show all posts"
								>
									All
								</button>
								{allTags.map(tag => (
									<button
										class="tag-button"
										data-tag={tag}
										aria-label={`Filter posts by ${tag}`}
									>
										{tag}
									</button>
								))}
							</div>
						</div>
					)}
				</div>
			</div>
		</section>

		<!-- Blog Posts -->
		<main class="main-content">
			<div class="container">
				{posts.length === 0 ? (
					<div class="no-posts">
						<h2>No posts found</h2>
						<p>There are no blog posts to display at the moment.</p>
					</div>
				) : (
					<div class="posts-grid" id="posts-grid">
						{posts.map((post) => (
							<BlogCard post={post} />
						))}
					</div>
				)}
			</div>
		</main>

		<Footer />
	</body>
</html>

<script>
	// Tag filtering functionality
	document.addEventListener('DOMContentLoaded', () => {
		const tagButtons = document.querySelectorAll('.tag-button');
		const postsGrid = document.getElementById('posts-grid');
		const postCards = postsGrid?.querySelectorAll('.blog-card') || [];

		tagButtons.forEach(button => {
			button.addEventListener('click', () => {
				const selectedTag = button.getAttribute('data-tag');

				// Update active button state
				tagButtons.forEach(btn => btn.classList.remove('active'));
				button.classList.add('active');

				// Filter posts
				postCards.forEach(card => {
					const postTags = card.querySelector('.blog-card__tags');
					const tags = postTags ? Array.from(postTags.children).map(span => span.textContent) : [];

					if (selectedTag === 'all' || tags.includes(selectedTag)) {
						card.style.display = 'block';
					} else {
						card.style.display = 'none';
					}
				});

				// Update grid layout for filtered items
				updateGridLayout();
			});
		});

		function updateGridLayout() {
			const visibleCards = Array.from(postCards).filter(card =>
				getComputedStyle(card).display !== 'none'
			);

			// If no posts are visible, show empty state
			if (visibleCards.length === 0 && postsGrid) {
				if (!postsGrid.querySelector('.no-filtered-posts')) {
					const noResults = document.createElement('div');
					noResults.className = 'no-filtered-posts';
					noResults.innerHTML = `
						<h3>No posts found</h3>
						<p>No posts match the selected tag. Try selecting a different tag.</p>
					`;
					postsGrid.appendChild(noResults);
				}
			} else {
				const noResults = postsGrid?.querySelector('.no-filtered-posts');
				if (noResults) {
					noResults.remove();
				}
			}
		}
	});
</script>

<style>
	/* Page Header */
	.page-header {
		padding: 4rem 0 3rem 0;
		background: linear-gradient(135deg, rgb(var(--bg-primary)) 0%, rgb(var(--bg-secondary)) 100%);
		border-bottom: 1px solid rgb(var(--border));
	}

	.page-header-content {
		max-width: 800px;
		margin: 0 auto;
		text-align: center;
	}

	.page-title {
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 700;
		margin: 0 0 1rem 0;
		color: rgb(var(--text-primary));
	}

	.page-description {
		font-size: 1.25rem;
		line-height: 1.6;
		color: rgb(var(--text-secondary));
		margin: 0 0 2rem 0;
	}

	.search-wrapper {
		max-width: 400px;
		margin: 0 auto 2rem auto;
	}

	/* Tag Filter */
	.tag-filter {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.filter-label {
		font-size: 0.875rem;
		font-weight: 600;
		color: rgb(var(--text-secondary));
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.tag-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
	}

	.tag-button {
		padding: 0.5rem 1rem;
		border: 1px solid rgb(var(--border));
		border-radius: 2rem;
		background: rgb(var(--bg-primary));
		color: rgb(var(--text-secondary));
		font-size: 0.875rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.tag-button:hover {
		background: rgb(var(--bg-secondary));
		border-color: rgb(var(--accent));
		color: rgb(var(--accent));
	}

	.tag-button.active {
		background: rgb(var(--accent));
		border-color: rgb(var(--accent));
		color: white;
	}

	/* Main Content */
	.main-content {
		padding: 4rem 0;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 2rem;
	}

	/* No Posts States */
	.no-posts,
	.no-filtered-posts {
		text-align: center;
		padding: 4rem 2rem;
	}

	.no-posts h2,
	.no-filtered-posts h3 {
		margin: 0 0 1rem 0;
		color: rgb(var(--text-primary));
		font-size: 1.5rem;
		font-weight: 600;
	}

	.no-posts p,
	.no-filtered-posts p {
		margin: 0;
		color: rgb(var(--text-secondary));
		font-size: 1rem;
	}

	/* Responsive Design */
	@media (max-width: 768px) {
		.page-header {
			padding: 3rem 0 2rem 0;
		}

		.page-title {
			font-size: clamp(2rem, 8vw, 3rem);
		}

		.page-description {
			font-size: 1.125rem;
		}

		.tag-buttons {
			flex-direction: column;
			align-items: center;
		}

		.tag-button {
			width: 100%;
			max-width: 200px;
		}

		.posts-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.main-content {
			padding: 3rem 0;
		}
	}

	@media (max-width: 480px) {
		.page-header {
			padding: 2rem 0 1.5rem 0;
		}

		.page-title {
			font-size: clamp(1.75rem, 8vw, 2.5rem);
		}

		.page-description {
			font-size: 1rem;
			margin-bottom: 1.5rem;
		}

		.search-wrapper {
			margin-bottom: 1.5rem;
		}

		.main-content {
			padding: 2rem 0;
		}
	}
</style>
