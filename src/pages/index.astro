---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import { config } from '../config';

import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const latestPosts = posts.slice(0, 3);
---

<Layout>
  <Hero />

  <section id="core-abilities" class="py-20">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-12 text-yellow-400">核心能力</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <Card
          icon="code"
          title="技术专家"
          description="全栈前端架构师，React 生态系统专家，跨平台产品开发经验"
        />
        <Card
          icon="team"
          title="团队领导者"
          description="以结果为导向的管理者，3 年团队管理，建立高效协作体系"
        />
        <Card
          icon="ai"
          title="AI 探索者"
          description="拥抱变革的学习者，主动转型 AI+产品的复合型人才"
        />
      </div>
    </div>
  </section>

  <section id="latest-updates" class="py-20 bg-gray-800/50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center mb-12 text-yellow-400">最新动态</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {latestPosts.map(post => (
          <Card
            category={post.data.category}
            title={post.data.title}
            summary={post.data.description}
            date={post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
            href={`/blog/${post.id}/`}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>