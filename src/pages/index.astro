import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

// 获取所有博客文章和日更文章
const blogPosts = await getCollection('blog');
const dailyPosts = await getCollection('daily');

// 合并所有文章并按日期排序
const allPosts = [...blogPosts, ...dailyPosts];
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// 计算统计数据
const totalPosts = allPosts.length;
const totalWords = allPosts.reduce((total, post) => {
    // 估算字数（简单方式）
    const content = post.body || '';
    return total + content.length;
}, 0);

// 获取最新的3篇文章
const recentPosts = sortedPosts.slice(0, 3);

// 计算日更连击数据
function calculateStreaks(dailyPosts) {
    if (dailyPosts.length === 0) {
        return {
            currentStreak: 0,
            longestStreak: 0,
            monthlyCount: 0,
            monthlyTotal: new Date().getDate() // 当前月份的天数
        };
    }

    // 按日期排序日更文章
    const sortedDailyPosts = dailyPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
    
    // 获取所有发布日期（去重）
    const publishDates = [...new Set(sortedDailyPosts.map(post => {
        const date = new Date(post.data.pubDate);
        return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    }))].sort().reverse();

    // 计算当前连击
    let currentStreak = 0;
    const today = new Date();
    let checkDate = new Date(today);
    
    // 从今天开始往前检查
    while (true) {
        const dateStr = `${checkDate.getFullYear()}-${String(checkDate.getMonth() + 1).padStart(2, '0')}-${String(checkDate.getDate()).padStart(2, '0')}`;
        
        if (publishDates.includes(dateStr)) {
            currentStreak++;
            checkDate.setDate(checkDate.getDate() - 1);
        } else {
            // 如果是今天且没有发布，继续检查昨天
            if (checkDate.toDateString() === today.toDateString()) {
                checkDate.setDate(checkDate.getDate() - 1);
                continue;
            }
            break;
        }
    }

    // 计算最长连击
    let longestStreak = 0;
    let tempStreak = 0;
    let prevDate = null;

    for (const dateStr of publishDates.reverse()) {
        const currentDate = new Date(dateStr);
        
        if (prevDate === null) {
            tempStreak = 1;
        } else {
            const diffTime = prevDate.getTime() - currentDate.getTime();
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            if (diffDays === 1) {
                tempStreak++;
            } else {
                longestStreak = Math.max(longestStreak, tempStreak);
                tempStreak = 1;
            }
        }
        
        prevDate = currentDate;
    }
    longestStreak = Math.max(longestStreak, tempStreak);

    // 计算本月完成天数
    const currentMonth = today.getMonth();
    const currentYear = today.getFullYear();
    const monthlyCount = publishDates.filter(dateStr => {
        const date = new Date(dateStr);
        return date.getMonth() === currentMonth && date.getFullYear() === currentYear;
    }).length;

    // 计算本月总天数
    const monthlyTotal = new Date(currentYear, currentMonth + 1, 0).getDate();

    return {
        currentStreak,
        longestStreak,
        monthlyCount,
        monthlyTotal
    };
}

const streakData = calculateStreaks(dailyPosts);

// 生成动态月份数据
function generateMonthsData(dailyPosts) {
    if (dailyPosts.length === 0) {
        // 如果没有日更文章，显示最近6个月
        const months = [];
        const today = new Date();
        for (let i = 5; i >= 0; i--) {
            const date = new Date(today.getFullYear(), today.getMonth() - i, 1);
            months.push({
                name: date.toLocaleString('zh-CN', { month: 'long' }).replace('月', '月'),
                year: date.getFullYear(),
                month: date.getMonth()
            });
        }
        return months;
    }

    // 获取所有发布日期
    const publishDates = dailyPosts.map(post => new Date(post.data.pubDate));
    const earliestDate = new Date(Math.min(...publishDates));
    const latestDate = new Date(Math.max(...publishDates));
    const today = new Date();
    
    // 确保包含到当前月份
    const endDate = latestDate > today ? latestDate : today;
    
    const months = [];
    let currentDate = new Date(earliestDate.getFullYear(), earliestDate.getMonth(), 1);
    
    while (currentDate <= endDate) {
        months.push({
            name: currentDate.toLocaleString('zh-CN', { month: 'long' }).replace('月', '月'),
            year: currentDate.getFullYear(),
            month: currentDate.getMonth()
        });
        currentDate.setMonth(currentDate.getMonth() + 1);
    }
    
    // 如果月份太多，只显示最近的12个月
    if (months.length > 12) {
        return months.slice(-12);
    }
    
    return months;
}

const monthsData = generateMonthsData(dailyPosts);

// 准备贡献图数据
const contributionData = dailyPosts.reduce((acc, post) => {
    const date = new Date(post.data.pubDate);
    // 确保日期格式正确（YYYY-MM-DD）
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const day = String(date.getDate()).padStart(2, '0');
    const dateStr = `${year}-${month}-${day}`;
    acc[dateStr] = 1; // 标记为有贡献
    return acc;
}, {});


