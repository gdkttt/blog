    <script define:vars={{ contributionData }}>
        // 从服务端传递的真实贡献数据
        const realContributions = contributionData;
        
        // 生成贡献图
        function generateContributionGraph() {
            const graph = document.getElementById('contribution-graph');
            const monthLabels = document.getElementById('month-labels');
            
            console.log('贡献数据:', realContributions); // 调试信息
            
            // 清空现有内容
            graph.innerHTML = '';
            if (monthLabels) {
                monthLabels.innerHTML = '';
            }
            
            const today = new Date();
            const endDate = new Date(today);
            const startDate = new Date(today.getFullYear() - 1, today.getMonth(), today.getDate() + 1);
            
            // 调整开始日期到周日
            while (startDate.getDay() !== 0) {
                startDate.setDate(startDate.getDate() - 1);
            }
            
            console.log('时间范围:', startDate.toISOString().split('T')[0], '到', endDate.toISOString().split('T')[0]); // 调试信息
            
            // 如果月份标签元素存在，清空并生成月份标签
            if (monthLabels) {
                const months = ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'];
                const currentMonth = today.getMonth();
                
                // 生成过去12个月的标签
                for (let i = 0; i < 12; i++) {
                    const monthIndex = (currentMonth - 11 + i + 12) % 12;
                    const monthElement = document.createElement('div');
                    monthElement.style.width = '40px';
                    monthElement.style.textAlign = 'center';
                    monthElement.textContent = months[monthIndex];
                    monthLabels.appendChild(monthElement);
                }
            }
            
            // 简化贡献图生成
            const todayStr = today.toISOString().split('T')[0];
            let date = new Date(startDate);
            
            // 生成固定的53周
            for (let week = 0; week < 53; week++) {
                const weekElement = document.createElement('div');
                weekElement.className = 'week';
                
                // 每周7天
                for (let day = 0; day < 7; day++) {
                    const dayElement = document.createElement('div');
                    dayElement.className = 'day';
                    
                    if (date <= endDate) {
                        const dateStr = date.toISOString().split('T')[0];
                        const hasContribution = realContributions[dateStr] || 0;
                        const isToday = dateStr === todayStr;
                        
                        // 使用CSS类而不是内联样式
                        if (hasContribution > 0) {
                            dayElement.classList.add('level-1');
                        }
                        
                        if (isToday) {
                            dayElement.classList.add('is-today');
                        }
                        
                        // 设置tooltip和点击事件
                        const formattedDate = new Date(dateStr).toLocaleDateString('zh-CN');
                        dayElement.title = `${formattedDate}: ${hasContribution > 0 ? '已发布日更 ✅' : '未发布 ❌'}${isToday ? ' (今天)' : ''}`;
                        
                        dayElement.addEventListener('click', () => {
                            alert(`日期: ${formattedDate}\n状态: ${hasContribution > 0 ? '已发布日更 ✅' : '未发布 ❌'}${isToday ? '\n这是今天 🎯' : ''}`);
                        });
                        
                        date.setDate(date.getDate() + 1);
                    } else {
                        // 超出范围的天数，设置为空白但保持结构
                        dayElement.style.backgroundColor = 'transparent';
                    }
                    
                    weekElement.appendChild(dayElement);
                }
                
                graph.appendChild(weekElement);
            }
        }

        // 页面加载完成后生成贡献图
        document.addEventListener('DOMContentLoaded', generateContributionGraph);
    </script>
</body>
</html>