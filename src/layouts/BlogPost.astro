---
// Blog Post Layout
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  slug: string;
};

const { title, description, pubDate, updatedDate, heroImage, tags, readingTime } = Astro.props;

// Format date for display
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
};

// Generate reading time text
const getReadingTimeText = (minutes: number) => {
  if (!minutes || minutes < 1) return '1 min read';
  return `${Math.ceil(minutes)} min read`;
};
---

<html lang="en">
	<head>
		<BaseHead
			title={`${title} | Blog`}
			description={description}
			image={heroImage}
		/>

		<!-- Article structured data for SEO -->
		<script type="application/ld+json" set:html={
			JSON.stringify({
				"@context": "https://schema.org",
				"@type": "BlogPosting",
				"headline": title,
				"description": description,
				"datePublished": pubDate.toISOString(),
				"dateModified": updatedDate?.toISOString() || pubDate.toISOString(),
				"author": {
					"@type": "Person",
					"name": "Blog Author"
				},
				...(tags && tags.length > 0 && {
					"keywords": tags.join(", ")
				}),
				...(readingTime && {
					"timeRequired": `PT${Math.ceil(readingTime)}M`
				})
			})
		} />
	</head>

	<body>
		<Header />

		<!-- Article Header -->
		<header class="article-header">
			<div class="container">
				<div class="article-meta">
					<div class="article-meta-primary">
						<time datetime={pubDate.toISOString()} class="article-date">
							{formatDate(pubDate)}
						</time>
						{readingTime && (
							<span class="article-reading-time">
								• {getReadingTimeText(readingTime)}
							</span>
						)}
					</div>

					{updatedDate && updatedDate > pubDate && (
						<div class="article-updated">
							Updated on {formatDate(updatedDate)}
						</div>
					)}
				</div>

				<h1 class="article-title">{title}</h1>

				<p class="article-description">{description}</p>

				{tags && tags.length > 0 && (
					<div class="article-tags">
						{tags.map((tag) => (
							<a
								href={`/blog?tag=${encodeURIComponent(tag)}`}
								class="article-tag"
								key={tag}
							>
								#{tag}
							</a>
						))}
					</div>
				)}
			</div>
		</header>

		<!-- Hero Image -->
		{heroImage && (
			<div class="article-hero">
				<div class="container">
					<div class="article-hero-image">
						<img
							src={heroImage.src}
							alt={title}
							width={heroImage.width}
							height={heroImage.height}
							loading="eager"
							decoding="async"
						/>
					</div>
				</div>
			</div>
		)}

		<!-- Article Content -->
		<main class="article-content">
			<div class="container">
				<div class="article-body">
					<!-- Table of Contents (will be populated by JavaScript) -->
					<div id="table-of-contents" class="toc-container">
						<div class="toc-header">
							<h3 class="toc-title">Table of Contents</h3>
							<button
								id="toc-toggle"
								class="toc-toggle"
								aria-label="Toggle table of contents"
							>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<polyline points="6,9 12,15 18,9"></polyline>
								</svg>
							</button>
						</div>
						<nav id="toc-nav" class="toc-nav">
							<!-- TOC will be generated here -->
						</nav>
					</div>

					<!-- Article text content -->
					<div class="prose">
						<slot />
					</div>
				</div>
			</div>
		</main>

		<!-- Article Footer -->
		<footer class="article-footer">
			<div class="container">
				<div class="article-footer-content">
					<div class="article-share">
						<h3 class="share-title">Share this post</h3>
						<div class="share-buttons">
							<a
								href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url)}`}
								class="share-button share-button--twitter"
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Share on Twitter"
							>
								<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
									<path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
								</svg>
								Twitter
							</a>

							<a
								href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url)}`}
								class="share-button share-button--linkedin"
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Share on LinkedIn"
							>
								<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
									<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
								</svg>
								LinkedIn
							</a>
						</div>
					</div>
				</div>
			</div>
		</footer>

		<Footer />

		<script>
			// Table of Contents functionality
			document.addEventListener('DOMContentLoaded', () => {
				const tocContainer = document.getElementById('table-of-contents');
				const tocNav = document.getElementById('toc-nav');
				const tocToggle = document.getElementById('toc-toggle');

				if (!tocContainer || !tocNav || !tocToggle) return;

				// Generate table of contents
				const headings = document.querySelectorAll('.prose h2, .prose h3, .prose h4, .prose h5, .prose h6');
				if (headings.length === 0) {
					tocContainer.style.display = 'none';
					return;
				}

				const tocList = document.createElement('ol');
				tocList.className = 'toc-list';

				headings.forEach((heading, index) => {
					const level = parseInt(heading.tagName.charAt(1));
					const text = heading.textContent || '';
					const id = heading.id || `heading-${index}`;

					// Ensure heading has an ID
					heading.id = id;

					const listItem = document.createElement('li');
					listItem.className = `toc-item toc-item--level-${level}`;

					const link = document.createElement('a');
					link.href = `#${id}`;
					link.textContent = text;
					link.className = 'toc-link';

					listItem.appendChild(link);
					tocList.appendChild(listItem);
				});

				tocNav.appendChild(tocList);

				// Toggle TOC visibility on mobile
				let tocVisible = true;
				tocToggle.addEventListener('click', () => {
					tocVisible = !tocVisible;
					tocNav.style.display = tocVisible ? 'block' : 'none';
					tocToggle.classList.toggle('active');
				});

				// Smooth scrolling for TOC links
				tocNav.addEventListener('click', (e) => {
					if (e.target.classList.contains('toc-link')) {
						e.preventDefault();
						const targetId = e.target.getAttribute('href')?.slice(1);
						const targetElement = document.getElementById(targetId);

						if (targetElement) {
							const headerHeight = 80;
							const targetPosition = targetElement.offsetTop - headerHeight;

							window.scrollTo({
								top: targetPosition,
								behavior: 'smooth'
							});

							// Update URL without triggering scroll
							history.pushState(null, '', `#${targetId}`);
						}
					}
				});

				// Highlight active TOC item on scroll
				const observerOptions = {
					rootMargin: '-80px 0px -80% 0px',
					threshold: 0
				};

				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						const id = entry.target.id;
						const tocLink = document.querySelector(`.toc-link[href="#${id}"]`);

						if (tocLink) {
							if (entry.isIntersecting) {
								document.querySelectorAll('.toc-link').forEach(link => {
									link.classList.remove('active');
								});
								tocLink.classList.add('active');
							}
						}
					});
				}, observerOptions);

				headings.forEach(heading => {
					observer.observe(heading);
				});
			});
		</script>
	</body>
</html>

<style>
	/* Article Header */
	.article-header {
		padding: 4rem 0 2rem 0;
		border-bottom: 1px solid rgb(var(--border));
	}

	.article-meta {
		margin-bottom: 1.5rem;
	}

	.article-meta-primary {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.875rem;
		color: rgb(var(--text-secondary));
		margin-bottom: 0.5rem;
	}

	.article-date,
	.article-reading-time {
		font-weight: 500;
	}

	.article-updated {
		font-size: 0.875rem;
		color: rgb(var(--text-tertiary));
		font-style: italic;
	}

	.article-title {
		font-size: clamp(2rem, 4vw, 3.5rem);
		font-weight: 700;
		line-height: 1.1;
		margin: 0 0 1rem 0;
		color: rgb(var(--text-primary));
	}

	.article-description {
		font-size: 1.25rem;
		line-height: 1.6;
		color: rgb(var(--text-secondary));
		margin: 0 0 1.5rem 0;
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.article-tag {
		color: rgb(var(--accent));
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		padding: 0.25rem 0.75rem;
		border: 1px solid rgb(var(--accent) / 0.3);
		border-radius: 2rem;
		transition: all 0.2s ease;
	}

	.article-tag:hover {
		background: rgb(var(--accent) / 0.1);
		border-color: rgb(var(--accent));
	}

	/* Article Hero */
	.article-hero {
		padding: 2rem 0;
		background: rgb(var(--bg-secondary));
	}

	.article-hero-image {
		max-width: 1200px;
		margin: 0 auto;
	}

	.article-hero-image img {
		width: 100%;
		height: auto;
		border-radius: 0.75rem;
		box-shadow: var(--shadow);
	}

	/* Article Content */
	.article-content {
		padding: 4rem 0;
	}

	.article-body {
		max-width: 800px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
	}

	/* Table of Contents */
	.toc-container {
		background: rgb(var(--bg-secondary));
		border: 1px solid rgb(var(--border));
		border-radius: 0.75rem;
		padding: 1.5rem;
	}

	.toc-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1rem;
	}

	.toc-title {
		margin: 0;
		font-size: 1.125rem;
		font-weight: 600;
		color: rgb(var(--text-primary));
	}

	.toc-toggle {
		background: none;
		border: 1px solid rgb(var(--border));
		border-radius: 0.375rem;
		padding: 0.5rem;
		cursor: pointer;
		color: rgb(var(--text-secondary));
		transition: all 0.2s ease;
		display: none;
	}

	.toc-toggle:hover {
		background: rgb(var(--bg-primary));
		border-color: rgb(var(--accent));
	}

	.toc-toggle.active svg {
		transform: rotate(180deg);
	}

	.toc-nav {
		font-size: 0.875rem;
	}

	.toc-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.toc-item {
		margin-bottom: 0.5rem;
	}

	.toc-item--level-3,
	.toc-item--level-4,
	.toc-item--level-5,
	.toc-item--level-6 {
		margin-left: 1rem;
	}

	.toc-link {
		color: rgb(var(--text-secondary));
		text-decoration: none;
		padding: 0.25rem 0;
		transition: all 0.2s ease;
		border-bottom: 1px solid transparent;
	}

	.toc-link:hover,
	.toc-link.active {
		color: rgb(var(--accent));
		border-bottom-color: rgb(var(--accent) / 0.3);
	}

	/* Prose Content */
	.prose {
		font-size: 1.125rem;
		line-height: 1.7;
		color: rgb(var(--text-primary));
	}

	.prose h2,
	.prose h3,
	.prose h4,
	.prose h5,
	.prose h6 {
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		line-height: 1.3;
		color: rgb(var(--text-primary));
	}

	.prose h2 { font-size: 1.875rem; }
	.prose h3 { font-size: 1.5rem; }
	.prose h4 { font-size: 1.25rem; }
	.prose h5 { font-size: 1.125rem; }
	.prose h6 { font-size: 1rem; }

	.prose p {
		margin-bottom: 1.5rem;
	}

	.prose ul,
	.prose ol {
		margin-bottom: 1.5rem;
		padding-left: 2rem;
	}

	.prose li {
		margin-bottom: 0.5rem;
	}

	.prose blockquote {
		border-left: 3px solid rgb(var(--accent));
		padding-left: 1.5rem;
		margin: 2rem 0;
		font-style: italic;
		color: rgb(var(--text-secondary));
	}

	/* Article Footer */
	.article-footer {
		padding: 4rem 0;
		background: rgb(var(--bg-secondary));
		border-top: 1px solid rgb(var(--border));
	}

	.article-footer-content {
		max-width: 800px;
		margin: 0 auto;
		text-align: center;
	}

	.article-share {
		margin-bottom: 2rem;
	}

	.share-title {
		margin: 0 0 1.5rem 0;
		font-size: 1.25rem;
		font-weight: 600;
		color: rgb(var(--text-primary));
	}

	.share-buttons {
		display: flex;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.share-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		border-radius: 0.5rem;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.875rem;
		transition: all 0.2s ease;
		border: 1px solid rgb(var(--border));
	}

	.share-button--twitter {
		background: #1da1f2;
		color: white;
		border-color: #1da1f2;
	}

	.share-button--twitter:hover {
		background: #0d95e8;
		border-color: #0d95e8;
	}

	.share-button--linkedin {
		background: #0077b5;
		color: white;
		border-color: #0077b5;
	}

	.share-button--linkedin:hover {
		background: #005885;
		border-color: #005885;
	}

	/* Responsive Design */
	@media (min-width: 1024px) {
		.article-body {
			grid-template-columns: 200px 1fr;
			gap: 3rem;
			align-items: start;
		}

		.toc-container {
			position: sticky;
			top: 6rem;
			height: fit-content;
		}
	}

	@media (max-width: 768px) {
		.article-header {
			padding: 3rem 0 1.5rem 0;
		}

		.article-title {
			font-size: clamp(1.75rem, 6vw, 2.5rem);
		}

		.article-description {
			font-size: 1.125rem;
		}

		.article-hero {
			padding: 1.5rem 0;
		}

		.article-content {
			padding: 3rem 0;
		}

		.article-body {
			gap: 2rem;
		}

		.toc-toggle {
			display: flex;
		}

		.toc-nav {
			display: none;
		}

		.toc-nav.active {
			display: block;
		}

		.article-footer {
			padding: 3rem 0;
		}

		.share-buttons {
			flex-direction: column;
			align-items: center;
		}

		.share-button {
			width: 200px;
			justify-content: center;
		}
	}

	@media (max-width: 480px) {
		.article-header {
			padding: 2rem 0 1rem 0;
		}

		.article-title {
			font-size: clamp(1.5rem, 8vw, 2rem);
		}

		.article-description {
			font-size: 1rem;
		}

		.article-content {
			padding: 2rem 0;
		}

		.article-footer {
			padding: 2rem 0;
		}
	}
</style>
