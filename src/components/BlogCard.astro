---
// Blog Card Component
interface Props {
  post: {
    id: string;
    slug: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      updatedDate?: Date;
      heroImage?: string;
      tags?: string[];
      draft?: boolean;
      readingTime?: number;
    };
  };
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { slug, data } = post;

// Format date
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(date);
};

// Generate reading time text
const getReadingTimeText = (minutes: number) => {
  if (minutes < 1) return '1 min read';
  return `${Math.ceil(minutes)} min read`;
};
---

<article class={`blog-card ${featured ? 'blog-card--featured' : ''}`}>
  {data.heroImage && (
    <div class="blog-card__image">
      <img
        src={data.heroImage}
        alt={data.title}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class="blog-card__content">
    <div class="blog-card__meta">
      <time datetime={data.pubDate.toISOString()} class="blog-card__date">
        {formatDate(data.pubDate)}
      </time>
      {data.readingTime && (
        <span class="blog-card__reading-time">
          {getReadingTimeText(data.readingTime)}
        </span>
      )}
    </div>

    <h2 class="blog-card__title">
      <a href={`/blog/${post.id}`} class="blog-card__link">
        {data.title}
      </a>
    </h2>

    <p class="blog-card__description">
      {data.description}
    </p>

    {data.tags && data.tags.length > 0 && (
      <div class="blog-card__tags">
        {data.tags.slice(0, 3).map((tag) => (
          <span class="blog-card__tag">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .blog-card {
    background: rgb(var(--bg-primary));
    border: 1px solid rgb(var(--border));
    border-radius: 0.75rem;
    overflow: hidden;
    transition: all 0.3s ease;
    box-shadow: var(--shadow);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    border-color: rgb(var(--accent) / 0.3);
  }

  .blog-card__image {
    position: relative;
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .blog-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .blog-card:hover .blog-card__image img {
    transform: scale(1.05);
  }

  .blog-card__content {
    padding: 1.5rem;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    color: rgb(var(--text-tertiary));
  }

  .blog-card__date,
  .blog-card__reading-time {
    font-weight: 500;
  }

  .blog-card__title {
    margin: 0 0 0.75rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .blog-card__link {
    color: rgb(var(--text-primary));
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .blog-card__link:hover {
    color: rgb(var(--accent));
  }

  .blog-card__description {
    margin: 0 0 1rem 0;
    color: rgb(var(--text-secondary));
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .blog-card__tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.5rem;
    background: rgb(var(--bg-secondary));
    color: rgb(var(--text-secondary));
    border-radius: 0.375rem;
    border: 1px solid rgb(var(--border));
    transition: all 0.2s ease;
  }

  .blog-card:hover .blog-card__tag {
    background: rgb(var(--accent) / 0.1);
    color: rgb(var(--accent));
    border-color: rgb(var(--accent) / 0.3);
  }

  /* Featured card styles */
  .blog-card--featured {
    grid-column: 1 / -1;
  }

  .blog-card--featured .blog-card__image {
    height: 300px;
  }

  .blog-card--featured .blog-card__title {
    font-size: 1.5rem;
  }

  .blog-card--featured .blog-card__description {
    -webkit-line-clamp: 4;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .blog-card__content {
      padding: 1.25rem;
    }

    .blog-card__title {
      font-size: 1.125rem;
    }

    .blog-card--featured .blog-card__image {
      height: 250px;
    }

    .blog-card--featured .blog-card__title {
      font-size: 1.375rem;
    }
  }

  @media (max-width: 480px) {
    .blog-card__image {
      height: 150px;
    }

    .blog-card--featured .blog-card__image {
      height: 200px;
    }

    .blog-card__content {
      padding: 1rem;
    }

    .blog-card__title {
      font-size: 1.125rem;
    }

    .blog-card--featured .blog-card__title {
      font-size: 1.25rem;
    }
  }
</style>
