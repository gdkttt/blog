---
import CodeIcon from './icons/CodeIcon.astro';
import TeamIcon from './icons/TeamIcon.astro';
import AiIcon from './icons/AiIcon.astro';

export interface Props {
  title: string;
  description?: string;
  icon?: 'code' | 'team' | 'ai';
  category?: string;
  summary?: string;
  date?: string;
  href?: string;
}

const { title, description, icon, category, summary, date, href } = Astro.props;

const icons = {
  code: CodeIcon,
  team: TeamIcon,
  ai: AiIcon,
};

const IconComponent = icon ? icons[icon] : null;

const CardWrapper = href ? 'a' : 'div';
const cardProps = href ? { href } : {};
---

<CardWrapper {...cardProps} class="group block bg-gray-800/50 border border-gray-700/50 rounded-lg p-6 transition-all duration-300 hover:border-yellow-400/50 hover:scale-[1.02] hover:shadow-2xl hover:shadow-yellow-400/10">
  {category && <span class="text-sm font-medium text-yellow-400">{category}</span>}
  
  {IconComponent && (
    <div class="mb-4 text-yellow-400">
      <IconComponent class="w-10 h-10" />
    </div>
  )}

  <h3 class:list={["text-xl font-bold text-gray-100", { "mt-2": category }]}>{title}</h3>
  
  {description && <p class="mt-2 text-gray-400">{description}</p>}
  {summary && <p class="mt-3 text-gray-400 text-base">{summary}</p>}

  {date && <p class="mt-4 text-sm text-gray-500">{date}</p>}

  {href && (
    <div class="mt-6 text-yellow-400 font-semibold flex items-center gap-2 group-hover:gap-3 transition-all duration-300">
      阅读更多
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </div>
  )}
</CardWrapper>