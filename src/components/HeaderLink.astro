---
export interface Props {
  href: string;
  isMobile?: boolean;
}

const { href, isMobile = false } = Astro.props;
const currentPath = new URL(Astro.request.url).pathname;
const isActive = href === currentPath || (href !== '/' && currentPath.startsWith(href));

const desktopClasses = "text-lg font-medium text-gray-300 hover:text-yellow-400 transition-colors duration-300 relative after:content-[''] after:absolute after:left-0 after:bottom-[-4px] after:w-0 after:h-[2px] after:bg-yellow-400 after:transition-all after:duration-300 hover:after:w-full";
const mobileClasses = "block px-3 py-2 rounded-md text-base font-medium text-gray-300 hover:text-white hover:bg-gray-700";
const activeDesktopClasses = "text-yellow-400 after:w-full";
const activeMobileClasses = "text-white bg-gray-800";

const classes = isMobile
  ? `${mobileClasses} ${isActive ? activeMobileClasses : ''}`
  : `${desktopClasses} ${isActive ? activeDesktopClasses : ''}`;
---

<a href={href} class={classes}>
  <slot />
</a>