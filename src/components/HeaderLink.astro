---
export interface Props {
	href: string;
}

const { href } = Astro.props;
---

<li><a href={href}><slot /></a></li>

<style>
    a {
        text-decoration: none;
        color: #666;
        font-weight: 500;
        transition: color 0.3s;
    }

    a:hover {
        color: #2563eb;
    }
</style>