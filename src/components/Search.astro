---
// Search Component
---

<div id="search-container" class="search-container">
	<div class="search-input-wrapper">
		<svg
			class="search-icon"
			width="20"
			height="20"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<circle cx="11" cy="11" r="8"></circle>
			<path d="m21 21-4.35-4.35"></path>
		</svg>

		<input
			id="search-input"
			type="text"
			placeholder="Search posts..."
			class="search-input"
			autocomplete="off"
		/>

		<button
			id="search-clear"
			class="search-clear"
			aria-label="Clear search"
			style="display: none;"
		>
			<svg
				width="16"
				height="16"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</div>

	<div id="search-results" class="search-results" style="display: none;">
		<div class="search-results-header">
			<span id="results-count" class="results-count">0 results found</span>
		</div>

		<div id="search-results-list" class="search-results-list">
			<!-- Results will be populated by JavaScript -->
		</div>

		<div id="no-results" class="no-results" style="display: none;">
			<p>No posts found matching your search.</p>
			<p class="no-results-suggestion">Try different keywords or check your spelling.</p>
		</div>
	</div>
</div>

<script>
	// Search functionality
	import Fuse from 'fuse.js';

	// This will be populated by the search data from the page
	let fuse;
	let searchData = [];

	// Initialize search when the component loads
	document.addEventListener('DOMContentLoaded', () => {
		const searchInput = document.getElementById('search-input');
		const searchClear = document.getElementById('search-clear');
		const searchResults = document.getElementById('search-results');
		const resultsCount = document.getElementById('results-count');
		const resultsList = document.getElementById('search-results-list');
		const noResults = document.getElementById('no-results');

		if (!searchInput || !searchResults) return;

		// Get search data from a script tag or fetch from API
		// For now, we'll assume the data is available in a global variable
		if (typeof window.searchIndex !== 'undefined') {
			searchData = window.searchIndex;
			fuse = new Fuse(searchData, {
				keys: ['title', 'description', 'tags', 'content'],
				threshold: 0.3,
				includeMatches: true,
				includeScore: true,
			});
		}

		// Search input handler
		searchInput.addEventListener('input', (e) => {
			const query = e.target.value.trim();

			if (query.length === 0) {
				searchResults.style.display = 'none';
				searchClear.style.display = 'none';
				return;
			}

			searchClear.style.display = 'block';
			performSearch(query);
		});

		// Clear search handler
		searchClear.addEventListener('click', () => {
			searchInput.value = '';
			searchInput.focus();
			searchResults.style.display = 'none';
			searchClear.style.display = 'none';
		});

		// Close search results when clicking outside
		document.addEventListener('click', (e) => {
			if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
				searchResults.style.display = 'none';
			}
		});

		// Handle keyboard navigation
		searchInput.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				searchResults.style.display = 'none';
				searchInput.blur();
			}
		});

		function performSearch(query) {
			if (!fuse) return;

			const results = fuse.search(query);
			displayResults(results, query);
		}

		function displayResults(results, query) {
			resultsList.innerHTML = '';
			noResults.style.display = 'none';

			if (results.length === 0) {
				noResults.style.display = 'block';
				resultsCount.textContent = '0 results found';
			} else {
				resultsCount.textContent = `${results.length} result${results.length === 1 ? '' : 's'} found`;

				results.slice(0, 10).forEach((result) => {
					const item = result.item;
					const resultElement = createResultElement(item, result.matches);
					resultsList.appendChild(resultElement);
				});
			}

			searchResults.style.display = 'block';
		}

		function createResultElement(post, matches) {
			const element = document.createElement('a');
			element.href = `/blog/${post.id}`;
			element.className = 'search-result-item';

			element.innerHTML = `
				<div class="search-result-content">
					<h3 class="search-result-title">${highlightMatches(post.title, matches)}</h3>
					<p class="search-result-description">${highlightMatches(post.description, matches)}</p>
					<div class="search-result-meta">
						<time datetime="${post.pubDate}">${formatDate(post.pubDate)}</time>
						${post.tags && post.tags.length > 0 ? `<span class="search-result-tags">${post.tags.slice(0, 2).join(', ')}</span>` : ''}
					</div>
				</div>
			`;

			return element;
		}

		function highlightMatches(text, matches) {
			if (!matches) return text;

			let highlightedText = text;
			const titleMatch = matches.find(match => match.key === 'title');

			if (titleMatch && titleMatch.indices) {
				highlightedText = highlightText(text, titleMatch.indices);
			}

			return highlightedText;
		}

		function highlightText(text, indices) {
			let result = '';
			let lastIndex = 0;

			indices.forEach(([start, end]) => {
				result += text.slice(lastIndex, start);
				result += `<mark>${text.slice(start, end + 1)}</mark>`;
				lastIndex = end + 1;
			});

			result += text.slice(lastIndex);
			return result;
		}

		function formatDate(dateString) {
			const date = new Date(dateString);
			return new Intl.DateTimeFormat('en-US', {
				year: 'numeric',
				month: 'short',
				day: 'numeric',
			}).format(date);
		}
	});
</script>

<style>
	.search-container {
		position: relative;
		width: 100%;
		max-width: 400px;
	}

	.search-input-wrapper {
		position: relative;
		display: flex;
		align-items: center;
	}

	.search-icon {
		position: absolute;
		left: 0.75rem;
		color: rgb(var(--text-tertiary));
		pointer-events: none;
		z-index: 1;
	}

	.search-input {
		width: 100%;
		padding: 0.75rem 1rem 0.75rem 2.5rem;
		border: 1px solid rgb(var(--border));
		border-radius: 0.5rem;
		background: rgb(var(--bg-primary));
		color: rgb(var(--text-primary));
		font-size: 0.875rem;
		transition: all 0.2s ease;
	}

	.search-input:focus {
		outline: none;
		border-color: rgb(var(--accent));
		box-shadow: 0 0 0 3px rgb(var(--accent) / 0.1);
	}

	.search-clear {
		position: absolute;
		right: 0.75rem;
		background: none;
		border: none;
		color: rgb(var(--text-tertiary));
		cursor: pointer;
		padding: 0.25rem;
		border-radius: 0.25rem;
		transition: all 0.2s ease;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.search-clear:hover {
		background: rgb(var(--bg-secondary));
		color: rgb(var(--text-primary));
	}

	.search-results {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background: rgb(var(--bg-primary));
		border: 1px solid rgb(var(--border));
		border-radius: 0.5rem;
		box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
		max-height: 400px;
		overflow-y: auto;
		z-index: 1000;
		margin-top: 0.5rem;
	}

	.search-results-header {
		padding: 0.75rem 1rem 0.25rem;
		border-bottom: 1px solid rgb(var(--border));
	}

	.results-count {
		font-size: 0.75rem;
		font-weight: 500;
		color: rgb(var(--text-secondary));
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.search-results-list {
		padding: 0.5rem 0;
	}

	.search-result-item {
		display: block;
		padding: 0.75rem 1rem;
		text-decoration: none;
		border-bottom: 1px solid rgb(var(--border));
		transition: background-color 0.2s ease;
	}

	.search-result-item:last-child {
		border-bottom: none;
	}

	.search-result-item:hover {
		background: rgb(var(--bg-secondary));
	}

	.search-result-content {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.search-result-title {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 600;
		color: rgb(var(--text-primary));
		line-height: 1.3;
	}

	.search-result-description {
		margin: 0;
		font-size: 0.75rem;
		color: rgb(var(--text-secondary));
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.search-result-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.75rem;
		color: rgb(var(--text-tertiary));
	}

	.search-result-tags {
		background: rgb(var(--bg-tertiary));
		color: rgb(var(--text-secondary));
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
		font-size: 0.625rem;
		font-weight: 500;
	}

	.no-results {
		padding: 2rem 1rem;
		text-align: center;
		color: rgb(var(--text-secondary));
	}

	.no-results p {
		margin: 0 0 0.5rem 0;
		font-size: 0.875rem;
	}

	.no-results-suggestion {
		font-size: 0.75rem;
		margin: 0;
	}

	mark {
		background: rgb(var(--accent) / 0.2);
		color: rgb(var(--accent));
		padding: 0.125rem 0.25rem;
		border-radius: 0.25rem;
		font-weight: 600;
	}

	/* Mobile adjustments */
	@media (max-width: 480px) {
		.search-container {
			max-width: none;
		}

		.search-results {
			position: fixed;
			top: auto;
			bottom: 1rem;
			left: 1rem;
			right: 1rem;
			max-height: 60vh;
		}
	}
</style>
